---
layout: null
sitemap: false
---
{%- if site.search_enabled -%}
[
{%- assign _items_count = 0 -%}
{%- assign _posts = site.posts | sort: 'date' | reverse -%}
{%- for post in _posts -%}
  {%- if _items_count > 0 -%},{%- endif -%}
  {%- assign _items_count = _items_count | plus: 1 -%}
  {%- assign _tag_labels = "" | split: "" -%}
  {%- for _t in post.tags -%}
    {%- assign _slug = _t | downcase | strip -%}
    {%- assign _meta = site.data.tags[_slug] -%}
    {%- assign _lbl = _meta.label | default: _t -%}
    {%- assign _tag_labels = _tag_labels | push: _lbl -%}
  {%- endfor -%}
  {
    "kind": "post",
    "type": "Artículo",
    "title": {{ post.title | jsonify }},
    "description": {{ post.description | default: post.excerpt | strip_html | strip_newlines | strip | jsonify }},
    "tags": {{ _tag_labels | jsonify }},
    "tagSlugs": {{ post.tags | jsonify }},
    "date": "{{ post.date | date: '%Y-%m-%d' }}",
    "url": {{ post.url | relative_url | jsonify }},
    "external": false
  }
{%- endfor -%}
{%- assign _acts = site.data.activities | sort: 'date' | reverse -%}
{%- for act in _acts -%}
  {%- if _items_count > 0 -%},{%- endif -%}
  {%- assign _items_count = _items_count | plus: 1 -%}
  {%- assign _tag_labels = "" | split: "" -%}
  {%- for _t in act.tags -%}
    {%- assign _slug = _t | downcase | strip -%}
    {%- assign _meta = site.data.tags[_slug] -%}
    {%- assign _lbl = _meta.label | default: _t -%}
    {%- assign _tag_labels = _tag_labels | push: _lbl -%}
  {%- endfor -%}
  {
    "kind": "activity",
    "type": {{ act.type | default: "Actividad" | jsonify }},
    "title": {{ act.title | jsonify }},
    "description": {{ act.summary | default: "" | strip_html | strip_newlines | strip | jsonify }},
    "tags": {{ _tag_labels | jsonify }},
    "tagSlugs": {{ act.tags | jsonify }},
    "date": "{{ act.date | date: '%Y-%m-%d' }}",
    "url": {{ act.url | relative_url | jsonify }},
    "external": {% if act.external %}true{% else %}false{% endif %}
  }
{%- endfor -%}
{%- assign _tag_names = "" | split: "" -%}
{%- for _t in site.tags -%}
  {%- assign _tag_names = _tag_names | push: _t[0] -%}
{%- endfor -%}
{%- assign _tag_names = _tag_names | sort_natural -%}
{%- for _tname in _tag_names -%}
  {%- if _items_count > 0 -%},{%- endif -%}
  {%- assign _items_count = _items_count | plus: 1 -%}
  {%- assign _tslug = _tname | downcase | strip -%}
  {%- assign _tmeta = site.data.tags[_tslug] -%}
  {%- assign _tlabel = _tmeta.label | default: _tname -%}
  {
    "kind": "tag",
    "type": "Etiqueta",
    "title": {{ "#" | append: _tlabel | jsonify }},
    "description": {{ _tmeta.description | default: "Explorar artículos de esta etiqueta." | jsonify }},
    "tags": [{{ _tlabel | jsonify }}],
    "tagSlugs": [{{ _tslug | jsonify }}],
    "date": "{{ site.tags[_tname].size }} {% if site.tags[_tname].size == 1 %}artículo{% else %}artículos{% endif %}",
    "url": {{ '/tag/' | append: _tslug | append: '/' | relative_url | jsonify }},
    "external": false
  }
{%- endfor -%}
]
{%- else -%}
[]
{%- endif -%}
